  pointer-events: none;
  z-index: 5;
}

.mapeditor .me-toast.show { opacity: 1; }

.mapeditor .me-close {
  position: absolute;
  top: 8px;
  right: 8px;
  z-index: 6;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  border: 1px solid #555;
  background: rgba(0, 0, 0, .6);
  color: #fff;
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
}

/* Full-screen overlay used when the editor opens inside the game. */
#editorOverlay {
  position: fixed;
  inset: 0;
  z-index: 2000;
  display: none;
}

#editorOverlay.open { display: block; }
