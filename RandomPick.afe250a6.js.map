  background: #3a3a3a;
  color: var(--me-text);
  border: 1px solid #444;
  border-radius: 4px;
  cursor: pointer;
  font: inherit;
}

.mapeditor .me-saved-list button.del { background: #a33; border-color: #a33; color: #fff; }

.mapeditor .me-toast {
  position: absolute;
  left: 50%;
  bottom: 40px;
  transform: translateX(-50%);
  background: var(--me-accent);
  color: #fff;
  padding: 9px 16px;
  border-radius: 5px;
  opacity: 0;
